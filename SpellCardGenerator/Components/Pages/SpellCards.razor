@page "/SpellCards/{LevelFilter:int?}"
@page "/SpellCards/Export/{LevelFilter:int?}"

@using System.Text.Json
@layout BlankLayout
@rendermode InteractiveServer

@inject NavigationManager _navManager
@inject IJSRuntime _js

@if (DoExport)
{
    <script src="scripts/html2canvas.min.js"></script>
    <script>
        window.takeScreenshot = async function(elementId, fileName) {
            const element = document.querySelector("#" + elementId);
            if (!element) {
                console.error("Element not found:", elementId);
                return;
            }
    
            const canvas = await html2canvas(element, { scale: 12 });
            const imgDataUrl = canvas.toDataURL("image/svg");
    
            // Trigger a download
            const link = document.createElement("a");
            link.href = imgDataUrl;
            link.download = fileName || "image.svg";
            link.click();
            
            return imgDataUrl; // Returns the image data as a Base64 string if needed in C#
        };
    </script>
}

@for (int index = 0; index < FilteredSpells.Count;)
{
    <div class="spell-page">
        @for (int counter = 1; counter <= 9 && index < FilteredSpells.Count; counter++, index++)
        {
            <SpellCard Spell="FilteredSpells[index]" />
        }
    </div>
}

@code {
    [Parameter]
    public int? LevelFilter { get; set; }

    private List<Models.Spell>? _loadedSpells;
    private List<Models.Spell>? LoadedSpells
    {
        get => _loadedSpells;
        set
        {
            _loadedSpells = value;
            FilteredSpells = _loadedSpells == null ? []
                : LevelFilter == null ? _loadedSpells.ToList() : _loadedSpells.Where(e => e.Level == LevelFilter).ToList();
        }
    }
    private bool _hasExported;

    private List<Models.Spell> FilteredSpells { get; set; } = [];

    public bool DoExport => _navManager.Uri.ToLowerInvariant().Contains("export");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool shouldRenderAgain = ( LoadedSpells == null );
        LoadedSpells ??= await LoadCachedSpellsAsync();

        if (LoadedSpells == null)
        {
            _navManager.NavigateTo("/");
            return;
        }

        if (shouldRenderAgain)
        {
            this.StateHasChanged();
            return;
        }

        if (!DoExport || _hasExported) { return; }

        _hasExported = true;

        foreach (var spell in FilteredSpells)
        {
            await GenerateSpellCardImage($"spell-card-{spell.Id}");
        }
    }

    private async Task GenerateSpellCardImage(string cardId)
    {
        try
        {
            await _js.InvokeVoidAsync("takeScreenshot", cardId, $"{cardId}.svg");
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"Failed to generate spell card image: {ex.Message}");
        }
    }

    private async Task<List<Models.Spell>?> LoadCachedSpellsAsync()
    {
        string? cachedJson;

        try
        {
            cachedJson = await _js.InvokeAsync<string?>("spellCache.getSpellJson");

            if (string.IsNullOrWhiteSpace(cachedJson))
            {
                return null;
            }

            var spells = JsonSerializer.Deserialize<List<Models.Spell>>(cachedJson);

            if (spells != null && spells.Count > 0)
            {
                return spells;
            }

            await _js.InvokeVoidAsync("spellCache.clearSpellJson");
        }
        catch(JSException ex)
        {
            Console.Error.WriteLine($"Failed to load cached spells from localStorage: {ex.Message}");
            return null;
        }
        catch (JsonException ex)
        {
            Console.Error.WriteLine($"Cached spell data is invalid. {ex.Message}");
        }

        return null;
    }
}
