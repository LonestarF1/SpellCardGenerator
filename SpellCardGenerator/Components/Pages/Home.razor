@page "/"
@rendermode InteractiveServer

@using System.Text.Json

@inject IJSRuntime _js

<PageTitle>Spell Data Setup</PageTitle>

<h1>Spell Data Setup</h1>

<p>Upload your spell JSON file to store it in this browser. The file stays available after closing and reopening the app.</p>

<div class="mb-3">
    <InputFile OnChange="OnFileSelectedAsync" accept=".json,application/json" />
</div>

<div class="mb-3">
    <button class="btn btn-outline-secondary" @onclick="ClearCachedSpellsButton_Clicked" disabled="@(_loadedSpellCount == 0)">Clear cached spells</button>
</div>

<p class="text-success mt-3" hidden="@string.IsNullOrWhiteSpace(_statusMessage)">@_statusMessage</p>
<p class="text-danger mt-3" hidden="@string.IsNullOrWhiteSpace(_errorMessage)">@_errorMessage</p>

@if (!_isInitialized)
{
    <p>Checking cached spell data...</p>
    return;
}

@if (_loadedSpellCount == 0)
{
    <p>No cached spell file found yet. Upload a JSON file to continue.</p>
    return;
}

<p><strong>@_loadedSpellCount</strong> spells loaded from browser cache.</p>

<div class="d-flex flex-wrap gap-2 mb-2">
    <a class="btn btn-primary" href="/SpellCards">Open all spell cards</a>
    <a class="btn btn-outline-primary" href="/SpellCards/Export">Export all spell cards</a>
</div>

<div class="d-flex flex-wrap gap-2">
    @foreach (var level in _availableLevels)
    {
        <a class="btn btn-sm btn-outline-success" href="@($"/SpellCards/{level}")">Open level @level</a>
    }
</div>

@code {
    private const long MaxUploadBytes = 10 * 1024 * 1024;

    private bool _isInitialized;
    private int _loadedSpellCount;
    private List<int> _availableLevels = [];
    private string? _statusMessage;
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadCachedSpellsAsync();
        _isInitialized = true;
        StateHasChanged();
    }

    private async Task LoadCachedSpellsAsync()
    {
        _loadedSpellCount = 0;
        _availableLevels = [];

        string? cachedJson;

        try
        {
            cachedJson = await _js.InvokeAsync<string?>("spellCache.getSpellJson");
            if (string.IsNullOrWhiteSpace(cachedJson))
            {
                return;
            }

            LoadJsonAndSetState(cachedJson);
        }
        catch (JSException ex)
        {
            _errorMessage = $"Unable to access browser storage right now. {ex.Message}";
        }
        catch (JsonException ex)
        {
            _errorMessage = $"Cached spell data is invalid. Upload a new JSON file. {ex.Message}";
            await _js.InvokeVoidAsync("spellCache.clearSpellJson");
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _statusMessage = null;
        _errorMessage = null;

        var file = args.File;

        if (file == null)
        {
            _errorMessage = "No file selected.";
            return;
        }

        if (file.Size > MaxUploadBytes)
        {
            _errorMessage = "Selected file is too large.";
            return;
        }

        string fileJson;

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var reader = new StreamReader(stream);
            fileJson = await reader.ReadToEndAsync();

            LoadJsonAndSetState(fileJson);

            await _js.InvokeVoidAsync("spellCache.setSpellJson", fileJson);
            _statusMessage = $"Loaded and cached {_loadedSpellCount} spells.";
        }
        catch (IOException ex)
        {
            _errorMessage = "Unable to read the selected file.";
            Console.Error.WriteLine($"{_errorMessage}: {ex.Message}");
            return;
        }
        catch (JsonException ex)
        {
            _errorMessage = $"Invalid spell JSON format.";
            Console.Error.WriteLine($"{_errorMessage}: {ex.Message}");
        }
        catch (JSException ex)
        {
            _errorMessage = $"Unable to save spell data to browser storage.";
            Console.Error.WriteLine($"{_errorMessage}: {ex.Message}");
        }
    }

    private async Task ClearCachedSpellsButton_Clicked()
    {
        _statusMessage = null;
        _errorMessage = null;

        try
        {
            await _js.InvokeVoidAsync("spellCache.clearSpellJson");
        }
        catch (JSException ex)
        {
            _errorMessage = $"Unable to clear browser storage right now. {ex.Message}";
            return;
        }

        _loadedSpellCount = 0;
        _availableLevels = [];
        _statusMessage = "Cached spell data cleared.";
    }

    private void LoadJsonAndSetState(string json)
    {
        var spells = JsonSerializer.Deserialize<List<Models.Spell>>(json);
        if (spells == null)
        {
            return;
        }

        _loadedSpellCount = spells.Count;
        _availableLevels = spells.Select(spell => spell.Level).Distinct().Order().ToList();
    }
}
